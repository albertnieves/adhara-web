{
  "$description": "PROPUESTA pendiente de aprobación. Tokens de los clips de L’Atelier du Désert en formato DTCG (W3C). Colores, familias, curva y duraciones salen de la tienda (src/app/globals.css, docs/DESIGN_SYSTEM.md) y se adaptan al vídeo. Las medidas en px son para el lado corto de 1080 px.",
  "$extensions": {
    "com.latelierdudesert.video": {
      "status": "propuesta",
      "version": "0.1.0",
      "contrast": [
        {
          "fg": "{color.role.text}",
          "bg": "{color.role.background}",
          "min": 4.5,
          "use": "Texto principal sobre el fondo"
        },
        {
          "fg": "{color.role.text}",
          "bg": "{color.role.surface}",
          "min": 4.5,
          "use": "Texto principal sobre la superficie oud"
        },
        {
          "fg": "{color.role.text-muted}",
          "bg": "{color.role.background}",
          "min": 4.5,
          "use": "Texto secundario sobre el fondo"
        },
        {
          "fg": "{color.role.text-muted}",
          "bg": "{color.role.surface}",
          "min": 4.5,
          "use": "Texto secundario sobre la superficie oud"
        },
        {
          "fg": "{color.role.accent}",
          "bg": "{color.role.background}",
          "min": 4.5,
          "use": "Cifras y etiquetas doradas sobre el fondo"
        },
        {
          "fg": "{color.role.accent}",
          "bg": "{color.role.surface}",
          "min": 4.5,
          "use": "Cifras y etiquetas doradas sobre la superficie oud"
        },
        {
          "fg": "{color.role.text-on-light}",
          "bg": "{color.role.background-light}",
          "min": 4.5,
          "use": "Texto sobre el fondo claro"
        },
        {
          "fg": "{color.role.accent}",
          "bg": "{color.role.background-light}",
          "min": 3,
          "use": "Solo filetes e iconos sobre el fondo claro: nunca texto"
        },
        {
          "fg": "{color.role.text}",
          "bg": "{color.role.subtitle-scrim}",
          "over": ["#ffffff", "#000000"],
          "min": 4.5,
          "use": "Subtítulos sobre la banda, con el vídeo más claro y más oscuro detrás"
        }
      ]
    }
  },
  "color": {
    "brand": {
      "$type": "color",
      "night": {
        "$value": "#0d0c0b",
        "$description": "Fondo de los clips. Es --color-night de la tienda."
      },
      "ivory": {
        "$value": "#f5f1ea",
        "$description": "Texto sobre oscuro y fondo claro. Es --color-ivory."
      },
      "gold": {
        "$value": "#a8844f",
        "$description": "Acento: cifras, filetes e iconos. Nunca fondo de texto (D4). Es --color-gold."
      },
      "oud": {
        "$value": "#2a1d15",
        "$description": "Superficie cálida (tarjetas de datos, bandas). Es --color-oud, el tono de colección de D3."
      }
    },
    "role": {
      "$type": "color",
      "background": { "$value": "{color.brand.night}" },
      "surface": { "$value": "{color.brand.oud}" },
      "background-light": { "$value": "{color.brand.ivory}" },
      "text": { "$value": "{color.brand.ivory}" },
      "text-muted": {
        "$value": "#f5f1eab8",
        "$description": "Marfil al 72 %: el único derivado, sin color nuevo."
      },
      "text-on-light": { "$value": "{color.brand.night}" },
      "accent": { "$value": "{color.brand.gold}" },
      "subtitle-scrim": {
        "$value": "#0d0c0bcc",
        "$description": "Banda opaca al 80 % detrás de los subtítulos. Sin desenfoque (nada de glassmorphism)."
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": "Cormorant Garamond",
        "$description": "Titulares y cifras grandes, como en la tienda (D1).",
        "$extensions": {
          "com.latelierdudesert.video": {
            "npm": "@fontsource/cormorant-garamond",
            "weights": [500, 600]
          }
        }
      },
      "text": {
        "$value": "Manrope",
        "$description": "Etiquetas, subtítulos y texto corrido (D1).",
        "$extensions": {
          "com.latelierdudesert.video": {
            "npm": "@fontsource/manrope",
            "weights": [400, 600]
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "display": { "$value": 500 },
      "display-strong": { "$value": 600 },
      "text": { "$value": 400 },
      "text-strong": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Escala modular: 40 px × 1,333 (cuarta justa) elevado al paso, redondeado al px. El paso -1 (30 px) es el mínimo: no hay texto más pequeño.",
      "$extensions": {
        "com.latelierdudesert.video": { "base": 40, "ratio": 1.333 }
      },
      "caption": {
        "$value": "30px",
        "$extensions": { "com.latelierdudesert.video": { "step": -1 } }
      },
      "body": {
        "$value": "40px",
        "$extensions": { "com.latelierdudesert.video": { "step": 0 } }
      },
      "lead": {
        "$value": "53px",
        "$extensions": { "com.latelierdudesert.video": { "step": 1 } }
      },
      "title-sm": {
        "$value": "71px",
        "$extensions": { "com.latelierdudesert.video": { "step": 2 } }
      },
      "title": {
        "$value": "95px",
        "$extensions": { "com.latelierdudesert.video": { "step": 3 } }
      },
      "title-lg": {
        "$value": "126px",
        "$extensions": { "com.latelierdudesert.video": { "step": 4 } }
      },
      "figure": {
        "$value": "168px",
        "$extensions": { "com.latelierdudesert.video": { "step": 5 } }
      },
      "figure-lg": {
        "$value": "224px",
        "$extensions": { "com.latelierdudesert.video": { "step": 6 } }
      }
    },
    "line-height": {
      "$type": "number",
      "display": { "$value": 0.95 },
      "text": { "$value": 1.3 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "display": { "$value": "-0.01em" },
      "caps": { "$value": "0.18em" }
    }
  },
  "typography": {
    "$type": "typography",
    "figure": {
      "$description": "Cifra grande de una tarjeta de datos.",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.figure-lg}",
        "fontWeight": "{font.weight.display}",
        "lineHeight": "{font.line-height.display}",
        "letterSpacing": "{font.letter-spacing.display}"
      }
    },
    "statement": {
      "$description": "La frase de la escena: una idea, alineada a un lado.",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.title-sm}",
        "fontWeight": "{font.weight.display}",
        "lineHeight": "{font.line-height.display}",
        "letterSpacing": "{font.letter-spacing.display}"
      }
    },
    "label": {
      "$description": "Etiqueta pequeña en versalitas bajo la cifra.",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.caption}",
        "fontWeight": "{font.weight.text-strong}",
        "lineHeight": "{font.line-height.text}",
        "letterSpacing": "{font.letter-spacing.caps}"
      }
    },
    "subtitle": {
      "$description": "Subtítulos de una locución, sobre la banda subtitle-scrim.",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.lead}",
        "fontWeight": "{font.weight.text-strong}",
        "lineHeight": "{font.line-height.text}",
        "letterSpacing": "0em"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Múltiplos de 8 px.",
    "1": { "$value": "8px" },
    "2": { "$value": "16px" },
    "3": { "$value": "24px" },
    "4": { "$value": "32px" },
    "6": { "$value": "48px" },
    "8": { "$value": "64px" },
    "12": { "$value": "96px" },
    "16": { "$value": "128px" },
    "24": { "$value": "192px" }
  },
  "grid": {
    "$description": "Rejilla de 12 columnas por formato, con columnas de ancho entero. Las zonas seguras del vertical son una propuesta conservadora: validarlas con la plantilla de cada red antes de publicar.",
    "vertical": {
      "width": { "$type": "dimension", "$value": "1080px" },
      "height": { "$type": "dimension", "$value": "1920px" },
      "columns": { "$type": "number", "$value": 12 },
      "margin": { "$type": "dimension", "$value": "72px" },
      "gutter": { "$type": "dimension", "$value": "24px" },
      "safe-top": { "$type": "dimension", "$value": "216px" },
      "safe-bottom": { "$type": "dimension", "$value": "384px" },
      "safe-right": { "$type": "dimension", "$value": "144px" }
    },
    "horizontal": {
      "width": { "$type": "dimension", "$value": "1920px" },
      "height": { "$type": "dimension", "$value": "1080px" },
      "columns": { "$type": "number", "$value": 12 },
      "margin": { "$type": "dimension", "$value": "120px" },
      "gutter": { "$type": "dimension", "$value": "24px" },
      "safe-top": { "$type": "dimension", "$value": "64px" },
      "safe-bottom": { "$type": "dimension", "$value": "64px" },
      "safe-right": { "$type": "dimension", "$value": "120px" }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "hairline": { "$value": "2px" }
  },
  "stroke": {
    "$type": "dimension",
    "rule": {
      "$value": "2px",
      "$description": "Filete dorado que separa cifra y etiqueta."
    }
  },
  "icon": {
    "$description": "Solo Lucide, con la misma rejilla, trazo y tamaño en todo el proyecto.",
    "$extensions": {
      "com.latelierdudesert.video": {
        "library": "lucide",
        "npm": "lucide-static",
        "absoluteStrokeWidth": false,
        "forbidden": [
          "sparkle",
          "sparkles",
          "wand",
          "wand-sparkles",
          "brain",
          "brain-circuit",
          "brain-cog",
          "bot",
          "cpu",
          "atom",
          "rocket",
          "zap"
        ]
      }
    },
    "grid": { "$type": "dimension", "$value": "24px" },
    "size": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Dos veces la rejilla."
    },
    "stroke-width": {
      "$type": "number",
      "$value": 1.5,
      "$description": "El trazo de los iconos propios de la tienda (Icon.tsx). Escala con el icono: 3 px a 48 px."
    },
    "color": { "$type": "color", "$value": "{color.role.accent}" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Toda duración de movimiento está entre 300 y 700 ms.",
      "quick": {
        "$value": "300ms",
        "$description": "Etiquetas e iconos."
      },
      "base": {
        "$value": "400ms",
        "$description": "Frases. Es --duration-base."
      },
      "slow": {
        "$value": "600ms",
        "$description": "Cifras y revelados. Es --duration-slow."
      },
      "scene": {
        "$value": "700ms",
        "$description": "Transición entre escenas: el máximo."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Sin rebote ni sobrepaso: los cuatro valores entre 0 y 1.",
      "luxe": {
        "$value": [0.22, 1, 0.36, 1],
        "$description": "Entradas. Es --ease-luxe de la tienda."
      },
      "inout": {
        "$value": [0.65, 0, 0.35, 1],
        "$description": "Transiciones entre escenas."
      },
      "exit": {
        "$value": [0.55, 0, 1, 0.45],
        "$description": "Salidas."
      }
    },
    "offset": {
      "$type": "duration",
      "stagger": {
        "$value": "90ms",
        "$description": "Desfase entre elementos de una misma entrada. No es una duración de movimiento."
      }
    },
    "distance": {
      "$type": "dimension",
      "rise": {
        "$value": "24px",
        "$description": "Desplazamiento máximo de una entrada."
      },
      "drift": {
        "$value": "48px",
        "$description": "Deriva máxima de cámara en 2D en toda la escena."
      }
    },
    "budget": {
      "per-scene": {
        "$type": "number",
        "$value": 3,
        "$description": "Movimientos de UI por escena, como máximo."
      }
    }
  },
  "text": {
    "max-words": {
      "$type": "number",
      "$value": 12,
      "$description": "Palabras en pantalla por escena: una idea."
    },
    "reading": {
      "words-per-second": {
        "$type": "number",
        "$value": 2.5,
        "$description": "Ritmo de lectura que se da por bueno."
      },
      "min-hold": {
        "$type": "duration",
        "$value": "1000ms",
        "$description": "Tiempo extra para encontrar el texto."
      }
    }
  },
  "image": {
    "$description": "Estilo fijo de imagen. scripts/lib/tokens.ts lo convierte en el bloque de estilo que llevan todos los prompts.",
    "$type": "string",
    "palette": {
      "$value": "Paleta cerrada: casi negro {color.brand.night}, marfil {color.brand.ivory}, oro viejo {color.brand.gold} y marrón oud {color.brand.oud}; sin colores saturados."
    },
    "light": {
      "$value": "Una sola fuente de luz natural de ventana, lateral y cálida (unos 3200 K), con sombras profundas de borde suave; sin luz de relleno ni contraluz."
    },
    "lens": {
      "$value": "Objetivo macro de 100 mm a f/5.6, cámara fija a la altura del objeto, perspectiva natural, sin gran angular."
    },
    "texture": {
      "$value": "Superficies mate y naturales: piedra caliza, lino crudo y latón envejecido; sin brillos plásticos."
    },
    "grain": {
      "$value": "Grano fino de película de 35 mm (ISO 400) y negros ligeramente levantados; sin viñeteado añadido."
    },
    "negative": {
      "$value": "Sin texto ni letras, sin caligrafía árabe, sin logotipos, sin frascos ni envases de marcas reales, sin personas ni manos, sin dunas, camellos ni lámparas, sin humo dorado, sin destellos ni bokeh de luces, sin gradientes violeta o cian."
    }
  }
}
