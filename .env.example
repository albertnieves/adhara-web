# El arranque técnico no requiere servicios externos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SEO_INDEXING=                # 1 solo tras aprobar apertura a buscadores; requiere VERCEL_ENV=production y dominio canónico
# Vacías para arrancar desconectado; usar Supabase local para desarrollar.
# atelier-dev contiene datos reales: no copiar sus variables a Preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ATELIER_PREVIEW_SUPABASE_REF= # Solo Preview: referencia de la base aislada (docs/OPERATIONS.md)
# SUPABASE_SECRET_KEY=          # Solo servidor; nunca NEXT_PUBLIC_ (invitaciones, informe diario, copia diaria, pedidos web y mensajes)
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# BOOTSTRAP_OWNER_EMAIL=
# Asistente de inventario (solo servidor):
# ANTHROPIC_API_KEY=            # Clave de la API de Claude; sin ella, informe sin resumen y chat desactivado
# CRON_SECRET=                  # Vercel Cron la envía a /api/cron/informe-diario, /copia-diaria, /caducar-reservas y /enviar-correos
# ASSISTANT_DAILY_LIMIT=40      # Consultas al asistente por persona y día
# Promociones por email con Sender (solo servidor; sin token la lista se guarda igual y se exporta en CSV):
# SENDER_API_TOKEN=             # Sender → Settings → API access tokens
# SENDER_GROUP_ID=              # Grupo de Sender al que se añaden las altas de la web (opcional)
# Consola del titular (opcional, solo servidor): copias de la plataforma Supabase.
# SUPABASE_BACKUPS_TOKEN=       # Token personal de Supabase limitado a «Backups: Read» de este proyecto
# Tienda online (P03): 1 enseña la cesta y el checkout. Apagado hasta conectar el TPV (P04).
# WEB_CHECKOUT=
# TPV virtual Redsys por redirección (P04, solo servidor; sin los cuatro no hay pago con tarjeta):
# REDSYS_MERCHANT_CODE=         # Número de comercio (FUC, 9 cifras)
# REDSYS_TERMINAL=              # Número de terminal (p. ej. 1)
# REDSYS_SECRET_KEY=            # Clave de firma SHA-256 que da el banco (de pruebas o la real)
# REDSYS_ENVIRONMENT=           # test o live, obligatorio
# REDSYS_MERCHANT_NAME=         # Opcional: nombre en la página del banco
# Correo de los pedidos con Resend (P06, solo servidor; sin los dos, los correos esperan en la cola):
# RESEND_API_KEY=               # Resend → API Keys (permiso de envío)
# EMAIL_FROM=                   # Remitente con el dominio verificado, p. ej. L’Atelier du Désert <pedidos@…>
# Bandeja de mensajes (A6.1, solo servidor):
# CONTACT_FORM=                 # 1 enseña el formulario de contacto; apagado hasta revisar la privacidad
# INBOUND_EMAIL_DOMAIN=         # Subdominio de Resend Inbound (MX), p. ej. respuestas.latelierdudesert.com
# RESEND_WEBHOOK_SECRET=        # Secreto de firma (whsec_…) del webhook email.received de Resend
# Envíos multitransportista con Sendcloud (DECISIONS §171–176, solo servidor; sin las dos claves solo hay servicios manuales):
# SENDCLOUD_PUBLIC_KEY=         # Clave pública de la integración de API (Sendcloud → Settings → Integrations)
# SENDCLOUD_SECRET_KEY=         # Clave secreta de la integración; también firma los avisos de seguimiento
# SENDCLOUD_WEBHOOK_SECRET=     # Opcional: «Webhook Signature Key» si la integración firma con una clave propia
